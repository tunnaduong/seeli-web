{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeli-web",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "seeli.cam", "custom_domain": true },
    { "pattern": "www.seeli.cam", "custom_domain": true },
    { "pattern": "seeli.tunnaduong.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
